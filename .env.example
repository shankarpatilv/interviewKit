POSTGRES_DB=interviewkit
POSTGRES_USER=interviewkit
POSTGRES_PASSWORD=interviewkit
POSTGRES_PORT=5432

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Application settings
DATABASE_URL=postgresql://interviewkit:interviewkit@localhost:5432/interviewkit
DEFAULT_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Optional Langfuse tracing (self-hosted; start with `docker compose --profile tracing up -d`).
# Tracing stays off unless BOTH keys are set. On first boot the local Langfuse server
# creates a project with exactly this key pair, so pick any values with these prefixes.
# LANGFUSE_PUBLIC_KEY=pk-lf-local-change-me
# LANGFUSE_SECRET_KEY=sk-lf-local-change-me
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PORT=3000
# Langfuse UI login created on first boot
# LANGFUSE_INIT_USER_EMAIL=dev@interviewkit.local
# LANGFUSE_INIT_USER_PASSWORD=change-me
# Internal Langfuse stack secrets (dev defaults exist; override for anything non-local)
# LANGFUSE_NEXTAUTH_SECRET=change-me
# LANGFUSE_SALT=change-me
# LANGFUSE_ENCRYPTION_KEY=  # 64 hex chars: openssl rand -hex 32
# LANGFUSE_DB_PASSWORD=change-me
# LANGFUSE_CLICKHOUSE_PASSWORD=change-me
# LANGFUSE_REDIS_PASSWORD=change-me
# LANGFUSE_MINIO_PASSWORD=change-me
